# Copy to `.env` (gitignored) for local debugging, or set these inside your MCP
# client's `env` block. The server reads everything from the environment.

# ─── Server mode ─────────────────────────────────────────────────────────────

# read  (default) — only the read tools are registered
#                   (list_environments, list_companies, list_entity_sets,
#                    query_entities, get_entity, export_file).
# write           — also registers create_entity, update_entity,
#                   invoke_bound_action. Every write call is audit-logged to
#                   stderr. These mutate real ERP data — posting a document
#                   creates ledger entries that cannot simply be deleted.
BC_MCP_MODE=read

# Additional opt-in for the destructive delete_entity tool. Requires
# BC_MCP_MODE=write. Set to "true" to enable. Defaults to off.
# delete_entity uses a two-step plan/apply confirmation.
BC_MCP_ALLOW_DELETE=false

# ─── Optional convenience ────────────────────────────────────────────────────

# Default environment name (e.g. "Production" or a sandbox name) used when a
# tool call omits `environment`. Discover valid names with list_environments.
# If unset, every call must pass `environment` explicitly. Tip: point this at
# a sandbox while experimenting with write mode.
BC_DEFAULT_ENVIRONMENT=

# Default company id (a GUID from list_companies) used when a tool call omits
# `company_id`. If unset, every entity call must pass `company_id` explicitly.
BC_DEFAULT_COMPANY_ID=

# Directory export_file writes into when a call omits `output_path`. If unset,
# exports land in the server's working directory.
BC_EXPORT_DIR=

# ─── Authentication ──────────────────────────────────────────────────────────

# Which credential type to use. One of:
#   interactive       (default) Opens a browser; for desktop devs.
#   device-code       Prints a code + URL to stderr; for SSH/WSL/headless.
#   cli               Uses your existing `az login` session (Azure CLI).
#   azure-powershell  Uses your existing `Connect-AzAccount` session (Az
#                     PowerShell). Use this on hosts that have Az PowerShell
#                     but not the az CLI.
#   service-principal Non-interactive, uses CLIENT_ID + CLIENT_SECRET below.
#                     NOTE: an SP must be registered as an Entra application
#                     inside Business Central (with API permissions) before it
#                     can call the data plane; delegated (interactive/cli)
#                     needs none of that but acts as the signed-in user with
#                     that user's BC permission sets.
#   managed-identity  For MCP servers hosted on Azure (VM, Container App, etc).
#   default           Tries env -> managed-identity -> CLI -> browser in turn.
BC_AUTH_MODE=interactive

# Entra (Azure AD) tenant ID.
# Required for: interactive, device-code, service-principal.
# Optional for: cli, azure-powershell, managed-identity, default.
AZURE_TENANT_ID=

# Application (client) ID.
# Optional for interactive/device-code (defaults to Azure CLI public client).
# Required for service-principal (the SP's app registration).
# Optional for managed-identity (only for user-assigned MI; omit for system-assigned).
AZURE_CLIENT_ID=

# Client secret for the service principal.
# Required ONLY when BC_AUTH_MODE=service-principal. Treat as a secret.
AZURE_CLIENT_SECRET=

# ─── Advanced overrides (rarely needed) ──────────────────────────────────────

# Token scope for the Business Central API. Override only for sovereign clouds.
# BC_SCOPE=https://api.businesscentral.dynamics.com/.default

# REST base for the Business Central API. Override only for sovereign clouds
# or embedded (ISV) deployments.
# BC_API_BASE=https://api.businesscentral.dynamics.com
